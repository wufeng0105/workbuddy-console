{
  "name": "workbuddy-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WorkBuddy 宿主层的个性化配置管理器 + 生效验证器",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:contracts": "node scripts/check-contracts.mjs && node scripts/check-residuals.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:frontend": "node --test test/frontend.test.mjs",
    "test:launcher": "node --test test/launcher.test.mjs",
    "selftest": "node src/selftest.mjs",
    "doctor": "node src/cli.mjs doctor",
    "start": "node src/launch.mjs",
    "verify:all": "npm run check:contracts && npm run selftest && npm run test"
  },
  "dependencies": {},
  "devDependencies": {}
}
